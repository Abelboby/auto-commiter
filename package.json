{
  "name": "auto-commiter",
  "displayName": "Auto Commiter",
  "description": "Generate per-file git commit messages with Groq and commit them from VS Code.",
  "version": "0.1.11",
  "publisher": "abelboby",
  "icon": "media/activity-bar.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abelboby/auto-commiter.git"
  },
  "homepage": "https://github.com/Abelboby/auto-commiter",
  "bugs": {
    "url": "https://github.com/Abelboby/auto-commiter/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "SCM"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:autoCommiter.runAutoCommit",
    "onCommand:autoCommiter.manageSettings",
    "onCommand:autoCommiter.setGroqApiKey",
    "onCommand:autoCommiter.openOutput",
    "onCommand:autoCommiter.checkForUpdates",
    "onCommand:autoCommiter.installUpdate",
    "onView:autoCommiter.sidebar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoCommiter",
          "title": "Auto Commiter",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "autoCommiter": [
        {
          "id": "autoCommiter.sidebar",
          "name": "Auto Commiter",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "autoCommiter.runAutoCommit",
        "title": "Auto Commiter: Generate and Commit Changes"
      },
      {
        "command": "autoCommiter.manageSettings",
        "title": "Auto Commiter: Manage Models and Settings",
        "icon": "$(gear)"
      },
      {
        "command": "autoCommiter.setGroqApiKey",
        "title": "Auto Commiter: Set Groq API Key",
        "icon": "$(key)"
      },
      {
        "command": "autoCommiter.openOutput",
        "title": "Auto Commiter: Open Output",
        "icon": "$(list-unordered)"
      },
      {
        "command": "autoCommiter.checkForUpdates",
        "title": "Auto Commiter: Check for Updates",
        "icon": "$(sync)"
      },
      {
        "command": "autoCommiter.installUpdate",
        "title": "Auto Commiter: Install Update",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autoCommiter.setGroqApiKey",
          "when": "view == autoCommiter.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "autoCommiter.manageSettings",
          "when": "view == autoCommiter.sidebar",
          "group": "navigation@2"
        },
        {
          "command": "autoCommiter.openOutput",
          "when": "view == autoCommiter.sidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Auto Commiter",
      "properties": {
        "autoCommiter.commitMode": {
          "type": "string",
          "enum": [
            "single",
            "batch"
          ],
          "default": "single",
          "description": "Commit mode used by the sidebar. Single generates one commit per file; batch will generate one commit for the selected files."
        },
        "autoCommiter.models": {
          "type": "array",
          "default": [
            {
              "id": "openai/gpt-oss-20b",
              "enabled": true,
              "maxCallsPerRun": 12,
              "costOrder": 1,
              "costTier": "primary"
            },
            {
              "id": "qwen/qwen3.6-27b",
              "enabled": true,
              "maxCallsPerRun": 6,
              "costOrder": 2,
              "costTier": "backup"
            },
            {
              "id": "openai/gpt-oss-120b",
              "enabled": true,
              "maxCallsPerRun": 12,
              "costOrder": 3,
              "costTier": "quality-fallback"
            },
            {
              "id": "groq/compound-mini",
              "enabled": true,
              "maxCallsPerRun": 10,
              "costOrder": 4,
              "costTier": "fast-fallback"
            },
            {
              "id": "groq/compound",
              "enabled": true,
              "maxCallsPerRun": 4,
              "costOrder": 5,
              "costTier": "final-fallback"
            },
            {
              "id": "allam-2-7b",
              "enabled": true,
              "maxCallsPerRun": 10,
              "costOrder": 6,
              "costTier": "language-fallback"
            }
          ],
          "description": "Groq models to try in order. Users can disable models, change limits, or add new models.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled",
              "maxCallsPerRun"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              },
              "maxCallsPerRun": {
                "type": "number",
                "minimum": 1
              },
              "costOrder": {
                "type": "number"
              },
              "costTier": {
                "type": "string"
              }
            }
          }
        },
        "autoCommiter.commitTagOptions": {
          "type": "array",
          "default": [
            "Add:",
            "Update:",
            "Fix:",
            "Refactor:",
            "Ignore:"
          ],
          "description": "Allowed commit message prefixes."
        },
        "autoCommiter.maxDiffCharacters": {
          "type": "number",
          "default": 4000,
          "minimum": 500,
          "description": "Maximum characters sent from a file diff or file content to Groq."
        },
        "autoCommiter.maxCommitWords": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "Maximum words allowed in the final commit message."
        },
        "autoCommiter.allowFallbackCommits": {
          "type": "boolean",
          "default": true,
          "description": "Allow normalized fallback commit messages when Groq responses fail validation."
        },
        "autoCommiter.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature sent to the Groq chat completions API."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile",
    "package:vsix": "vsce package",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor",
    "publish:major": "vsce publish major",
    "prepublishOnly": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.8.3"
  }
}
